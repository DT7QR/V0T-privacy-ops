class SignalWizardActivity : Activity() {
    private lateinit var binding: ActivitySignalWizardBinding
    private var lastPayloadJson: String = "{}"
    private var experimentalEnabled: Boolean = false

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        SecureScreen.apply(this)
        binding = ActivitySignalWizardBinding.inflate(layoutInflater)
        setContentView(binding.root)

        experimentalEnabled = getSharedPreferences("devtools", MODE_PRIVATE)
            .getBoolean("experimental_enabled", false)

        binding.swLiveMode.setOnCheckedChangeListener { _, isChecked ->
            Toast.makeText(this, "Live Mode: $isChecked", Toast.LENGTH_SHORT).show()
            loadSignals(if (isChecked) "1H" else "Daily", live = isChecked)
        }
        loadSignals("1H", live = true)

        binding.btnSubscribe.setOnClickListener {
            if (experimentalEnabled) {
                val root = SecurityUtils.sha256(lastPayloadJson)
                val iccidHash = "stub_iccid_hash"
                val ok = CloudflareWorkerClient.relayEcho(root, iccidHash, "123456")
                Toast.makeText(this, "Experimental relay: $ok", Toast.LENGTH_SHORT).show()
