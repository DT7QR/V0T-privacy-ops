package com.v0t.cloud
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.RequestBody.Companion.toRequestBody
import org.json.JSONObject
import com.v0t.policy.NetworkPolicy

object CloudflareWorkerClient {
    private val client = OkHttpClient()
    private val baseUrl get() = com.v0t.BackendLinksSecure.getWorker(com.v0t.AppCtx.get())

    fun relayEcho(root: String, iccidHash: String, nonce: String): Boolean {
        val ctx = com.v0t.AppCtx.get()
        if (!NetworkPolicy.isAllowedToCallBackend(ctx)) return false
        val payload = JSONObject().apply {
            put("root", root); put("iccidHash", iccidHash); put("nonce", nonce)
        }.toString()
        val req = Request.Builder().url(baseUrl)
            .post(payload.toRequestBody("application/json".toMediaType())).build()
        return try { client.newCall(req).execute().use { it.isSuccessful } } catch (_: Exception) { false }
    }

    fun queryEchoes(iccidHash: String): List<String> {
        val ctx = com.v0t.AppCtx.get()
        if (!NetworkPolicy.isAllowedToCallBackend(ctx)) return emptyList()
        val url = "$baseUrl?iccidHash=$iccidHash"
        val req = Request.Builder().url(url).get().build()
        return try {
            client.newCall(req).execute().use { resp ->
                if (!resp.isSuccessful) return emptyList()
                val body = resp.body?.string() ?: "[]"
                val arr = org.json.JSONArray(body)
                (0 until arr.length()).map { arr.getString(it) }
            }
        } catch (_: Exception) { emptyList() }
    }
}
