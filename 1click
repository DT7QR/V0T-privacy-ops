            val s = signals.firstOrNull()
            binding.tvSignal.text = if (s != null) {
                lastPayloadJson = SignalParser.toJson(s)
                "Signal: ${s.strategy} ${s.side} (${String.format("%.2f", s.confidence)}) @ ${s.tf}"
            } else "No signals."
        }
    }
}
