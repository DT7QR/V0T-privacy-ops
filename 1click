package com.v0t.backend
import android.util.Log
import okhttp3.OkHttpClient
import okhttp3.Request
import org.json.JSONArray
import com.v0t.policy.NetworkPolicy

object FastDBClient {
    fun fetchSignals(tf: String = "1H", limit: Int = 5, baseUrl: String? = null): List<SignalPayload> {
        val ctx = com.v0t.AppCtx.get()
        if (!NetworkPolicy.isAllowedToCallBackend(ctx)) {
            Log.w("FastDBClient","Blocked by NetworkPolicy")
            return stub(tf)
        }
        val url = (baseUrl ?: com.v0t.BackendLinksSecure.getFastDb(ctx)).plus("?tf=$tf&limit=$limit")
        val req = Request.Builder().url(url).get().build()
        return try {
            OkHttpClient().newCall(req).execute().use { resp ->
                if (!resp.isSuccessful) {
                    Log.w("FastDBClient","HTTP ${resp.code} for $url")
                    return stub(tf)
                }
                val body = resp.body?.string() ?: "[]"
                val arr = JSONArray(body)
                val out = (0 until arr.length()).mapNotNull { i -> SignalParser.parse(arr.getJSONObject(i).toString()) }
                out.ifEmpty { stub(tf) }
            }
        } catch (e: Exception) {
            Log.w("FastDBClient","Error: ${e.message}")
            stub(tf)
        }
    }
    private fun stub(tf: String) = listOf(
        SignalPayload("pinescript.signal","EMA Cross",tf,"BUY",0.82,System.currentTimeMillis())
    )
}
